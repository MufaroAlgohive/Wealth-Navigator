<?xml version="1.0" encoding="utf-8"?>
<!--
  Take-profit order — illustrative request combining IFDONE + AUTODESK + FIXED CO.
  The parent BUY goes on AUTODESK; the child SELL (take-profit) is on IFDONE,
  with a FIXED CO trigger that gates activation.
  See ../05-services/iosplus/contingent-orders/07-take-profit.md
-->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <OrderCreate3 xmlns="http://webservices.iress.com.au/v4/">
      <Input>
        <Header>
          <ServiceSessionKey>ef0123ab-...@WebServicesTestA.iress.com.au</ServiceSessionKey>
          <RequestID>tp-parent-1</RequestID>
          <Updates>false</Updates>
          <Timeout>25</Timeout>
          <PageSize>0</PageSize>
          <WaitForResponse>true</WaitForResponse>
          <PagingBookmark/>
          <PagingDirection>0</PagingDirection>
        </Header>
        <Parameters>
          <Order>
            <AccountCode>MINT-LIVE-001</AccountCode>
            <SecurityCode>SHP</SecurityCode>
            <Exchange>JSE</Exchange>
            <BuySell>1</BuySell>
            <OrderType>MKT</OrderType>
            <Volume>1000</Volume>
            <Destination>AUTODESK</Destination>
            <TimeInForce>DAY</TimeInForce>
            <OrderTag>mint-tp-parent-...</OrderTag>
          </Order>
        </Parameters>
      </Input>
    </OrderCreate3>
  </soap:Body>
</soap:Envelope>
