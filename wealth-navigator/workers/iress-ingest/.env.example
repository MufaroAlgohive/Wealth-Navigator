# ── IRESS (SOAP session — server-side only) ─────────────────────────────
# Production defaults target LIVE IRESS CT with the Supabase worker enabled.
# Flip the safety gates back to 0/1 for local mock / dry-run.
IRESS_MODE=mock
IRESS_USERNAME=
IRESS_PASSWORD=
IRESS_COMPANY_NAME=Mint
IRESS_BASE_URL=https://webservices-ct.iress.co.za/v4
IRESS_REGION=ZA
# Default exchange passed to PricingQuoteGet (defaults to "JSE" if unset).
# Set per-market: e.g. IRESS_DEFAULT_EXCHANGE=ASX for Australian equities.
IRESS_DEFAULT_EXCHANGE=JSE
# Per-class exchange codes. The worker uses these for non-equity watchlist
# entries (FX, money-market) so a single JSE PricingQuoteGet loop can pull
# everything the Cockpit needs in one go — no need to wait for TimeSeriesGet2
# entitlements on Tier 2 wiring.
IRESS_FX_EXCHANGE=FX
IRESS_MM_EXCHANGE=MM
# Optional — sticky ApplicationID label persisted to worker_session_metadata.
# Keep this stable per Railway replica so IRESS reconnects to the same seat.
IRESS_APPLICATION_LABEL=Mint-OEMS-Worker
# Optional — accounts the orders.ts stub polls (OrderPadGetByAccount).
# Comma-separated, no spaces. Empty list = poll disabled.
# Set this on Railway to populate the Cockpit Open-Orders panel via the
# worker → oems_order_audit mirror.
IRESS_ACCOUNT_CODE=

# ── UAT mode (Mint OEM Finalisation Phase UAT) ───────────────────────
# When IRESS_UAT_MODE=1, the worker:
#  - accepts POST /uat/send-to-market (calls IRESS OrderCreate3 on MINT_CT
#    IOS using IRESS_UAT_ACCOUNT_CODE — a separate broker account)
#  - polls OrderPadGetByAccount on the UAT account every
#    IRESS_UAT_ORDER_POLL_SEC and writes fills back to oems_order_audit
#  - exposes /uat/status and /uat/execution-stream for the Vercel BFF
# Production default: OFF. The order pipeline stays in audit-only mode
# (deferred to manual Excel upload via /api/admin/orderbook/fills) until
# IRESS_UAT_MODE is explicitly set.
#
# Critical: IRESS_UAT_ACCOUNT_CODE MUST differ from IRESS_ACCOUNT_CODE.
# The /uat/send-to-market handler refuses any account that matches the
# production IRESS_ACCOUNT_CODE so a misconfiguration cannot route UAT
# orders to a real client book.
#
# Operator: Andre Pietersen (IRESS). The MINT_CT IOS seat confirms
# OrderCreate3 works as of 2026-07-09.
IRESS_UAT_MODE=0
IRESS_UAT_ACCOUNT_CODE=
IRESS_UAT_ORDER_POLL_SEC=30

# Comma-separated symbols to poll. The default list combines 20 JSE Top-40
# names with USDZAR (FX) and JIBAR_3M (money-market) so the Cockpit has
# live data on every KPI tile. Override the list (without FX/MM) by setting:
#   IRESS_WATCHLIST_SYMBOLS=NPN,PRX,FSR,SBK,AGL,BHG,MTN,SOL,SHP,CPI
# IRESS_WATCHLIST_SYMBOLS=NPN,PRX,FSR,SBK,AGL,BHG,MTN,SOL,SHP,CPI,REM,BID,ABG,SLM,AMS,WHL,TBS,GRT,CLS,MNP,USDZAR,JIBAR_3M
#
# Per-symbol exchange overrides (rarely needed; only when the IRESS reference
# data for a code lives on a non-default exchange). Comma-separated SYM=EX.
# Default kind→exchange map is: fx→FX, money-market→MM, else defaultExchange.
# IRESS_WATCHLIST_EXCHANGES=USDZAR=FX,JIBAR_3M=MM

# When 1, the worker upserts instruments from IRESS InstrumentLookup
# results into `securities_c` (mark with source='iress-worker'). Off by default.
IRESS_WORKER_INSTRUMENT_SYNC=0

# ── Supabase (service role — worker only, never expose to browser) ──────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Safety gates ────────────────────────────────────────────────────────
# Both must be flipped to (0, 1) for the worker to write to the LIVE database.
# Default here is the production target; flip IRESS_WORKER_DRY_RUN=1 for staging.
IRESS_WORKER_DRY_RUN=0
SUPABASE_ALLOW_WRITES=1

# ── Worker tuning ───────────────────────────────────────────────────────
WORKER_ID=iress-ingest-1
IRESS_WORKER_HEARTBEAT_SEC=30
IRESS_WORKER_QUOTE_INTERVAL_SEC=15
IRESS_WORKER_ORDER_POLL_SEC=60
