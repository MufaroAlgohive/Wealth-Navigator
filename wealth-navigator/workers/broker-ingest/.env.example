# ── broker-ingest (Railway worker, sibling to iress-ingest) ──────────────
# Mint OEM Finalisation Phase C4: broker-feed mock worker. Polls a broker
# API every BROKER_POLL_INTERVAL_MS, writes fills into INSTITUTIONAL
# `oems_order_audit`, marks orders as filled when 100% complete, and
# flips `rebalance_request_c.status='executed'` once a book is done.
#
# The broker API real integration is BLOCKED on Lonwabo confirming the
# vendor. This worker runs in mock mode by default — `POST /debug/inject-fill`
# on the in-process HTTP API seeds fills for verification + dev work.
#
# Production target defaults to the SAFETY posture (mock mode + dry-run);
# flip BROKER_MODE=live AND BROKER_WORKER_DRY_RUN=0 AND
# SUPABASE_ALLOW_WRITES=1 in tandem to enable real writes.

# 'mock' generates fake fills every poll + exposes /debug/inject-fill.
# 'live' calls BROKER_API_URL (not yet implemented; vendor pending).
BROKER_MODE=mock

# Production broker endpoint — TSIE/Lonwabo to provide.
BROKER_API_URL=
BROKER_API_KEY=

# Poll cadence (ms). Default 60s; lower for staging.
BROKER_POLL_INTERVAL_MS=60000

# ── Supabase (service role — worker only, never expose to browser) ──────
# Targets the INSTITUTIONAL prod (nnwz…). Falls back to legacy SUPABASE_*
# so existing deploys are unchanged.
INSTITUTIONAL_SUPABASE_URL=
INSTITUTIONAL_SUPABASE_SERVICE_ROLE_KEY=
# Back-compat fallback:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Safety gates ───────────────────────────────────────────────────────
# Both must be flipped to (0, 1) for the worker to write to the LIVE database.
BROKER_WORKER_DRY_RUN=1
SUPABASE_ALLOW_WRITES=0

# ── Worker tuning ──────────────────────────────────────────────────────
WORKER_ID=broker-ingest-1
BROKER_WORKER_HEARTBEAT_SEC=30

# ── HTTP API ───────────────────────────────────────────────────────────
WORKER_HTTP_PORT=8766
WORKER_HTTP_TOKEN=
