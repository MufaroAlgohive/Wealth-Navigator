# ── Active market-data provider selector ─────────────────────────────────
# Mint OEM Phase C1: ACTIVE_MARKET_DATA_PROVIDER picks which provider the
# BFFs read from. Selector lives in src/lib/data-policy.ts (provider registry
# in src/lib/data/providers/index.ts). Default below is 'yahoo' so a fresh
# Vercel deploy (which has USE_SUPABASE_QUOTES=true and worker-ingested
# snapshots) never accidentally serves the in-process mock seed as if it
# were real market data.
#
# Accepted values:
#   yahoo  — Yahoo Finance v7 quote endpoint (US/global; cheap + unrestricted;
#            primary for global ETF prices + IRESS symbols that map to .JO).
#            Will return 401 on direct auth-required endpoints, in which
#            case the provider surfaces the row with source="yahoo" + error.
#   iress  — IRESS V4 SOAP via the Railway worker. Only valid when the
#            worker is reachable (IRESS_WORKER_URL set) and IRESS_MODE=live.
#            Otherwise the IRESS provider falls back to the in-process seed.
#   mock   — In-process seed from src/lib/iress/seed.ts. Dev only; never
#            deploy to Vercel prod. Used by /api/quotes when no real
#            provider is reachable.
#   iris   — Stub (returns 'unconfigured'); reserved for the post-launch
#            Research-Lab follow-up (see docs/VENDOR_ENTITLEMENT_STATUS.md).
ACTIVE_MARKET_DATA_PROVIDER=yahoo

# ── IRESS V4 integration ────────────────────────────────────────────────
# 'mock' uses the in-process mock adapter (default for v2.0 dev).
# 'live' uses a real IRESS SOAP connection (needs creds).
# 'wsdl-stub' generates typed stubs from a saved WSDL file (CI mode).
# IMPORTANT: only the Railway worker should run IRESS_MODE=live. Vercel
# keeps IRESS_MODE=mock + ACTIVE_MARKET_DATA_PROVIDER=yahoo +
# USE_SUPABASE_QUOTES=true so the UI reads worker-ingested DB snapshots
# instead of reaching for the CT seat from serverless. See
# docs/PROVIDER_SWITCH_RUNBOOK.md §4 for the cutover + rollback procedure.
IRESS_MODE=mock

# IRESS Web Services credentials (SOAP session — NOT app login)
IRESS_USERNAME=
IRESS_PASSWORD=
IRESS_COMPANY_NAME=Mint

# Optional — trading account for live OrderPadGetByAccount (blotter)
# IRESS_ACCOUNT_CODE=MINT-LIVE-001

# Production / test endpoints — see Documentation & Vision/iress-v4-docs/01-foundations/03-endpoints.md
IRESS_BASE_URL=https://webservices-ct.iress.co.za/v4
IRESS_PROD_URL=https://webservices.iress.co.za/v4

# Region + application label surfaced to IRESS admin tooling
IRESS_REGION=ZA
IRESS_APPLICATION_LABEL=Mint-OEMS-Production

# Cut-down WSDL method lists (matches docs/03-endpoints.md recommendation).
# Leave empty to send all entitled methods.
IRESS_IRESS_METHODS=IRESSSessionStart,TimeSeriesGet2,PricingQuoteGet,PricingQuoteExGet
IRESS_IOS_METHODS=ServiceSessionStart,OrderCreate3,OrderAmend2,OrderDelete,OrderPadGetByAccount,OrderPadGetByAccountUpdates,BookingGetByOrganisation2,DestinationGet,DestinationDetailGet,AttributeGetByUser
IRESS_IPS_METHODS=ServiceSessionStart,IPSTransactionGetByAccount5,IPSAccountGetAll1,IPSPositionGetAll1
IRESS_FIX_METHODS=ServiceSessionStart,TargetIDGet,TargetIDStatusGet

# ── Supabase — 3-DB topology (see wealth-navigator/docs/DB_TOPOLOGY_DECISION.md) ──
# RETAIL prod (mfxnghmuccevsxwcetej): customer books + shared price tables
#   securities_c / stock_intraday_c. INSTITUTIONAL prod (nnwzhxfjpjbzujevwzlh):
#   desk trading book + analytics + worker ops. STAGING: a fresh project for
#   validating IRESS + migrations before prod.
#
# Auth (browser + middleware) targets the RETAIL prod — consumer auth lives there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Split service-role targets (server-only: Vercel encrypted env, Railway worker, API routes).
# If unset, the code falls back to the legacy SUPABASE_* pair below (treated as INSTITUTIONAL),
# so existing deploys are unchanged until these are set.
RETAIL_SUPABASE_URL=
RETAIL_SUPABASE_SERVICE_ROLE_KEY=
INSTITUTIONAL_SUPABASE_URL=
INSTITUTIONAL_SUPABASE_SERVICE_ROLE_KEY=
# STAGING_SUPABASE_URL=
# STAGING_SUPABASE_SERVICE_ROLE_KEY=

# Legacy single pair — back-compat fallback for both targets until the split vars are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical Excel-ledger daily writer. Keep disabled until the DRAFT shadow
# output has been reviewed; the cron remains read-only while this is 0.
CANONICAL_LEDGER_DRAFT_APPLY=0

# Feature flag: read intraday quotes from Supabase instead of seed/API (default off)
USE_SUPABASE_QUOTES=false
# Browser mirror — enables /api/quotes polling + Realtime on OEMS (set true with USE_SUPABASE_QUOTES on Vercel)
NEXT_PUBLIC_USE_SUPABASE_QUOTES=false

# Worker safety (local/Railway) — see workers/iress-ingest/.env.example
# IRESS_WORKER_DRY_RUN=1
# SUPABASE_ALLOW_WRITES=0

# ── IRESS feed monitor (cron/iress-monitor) ──────────────────────────────
# Discord webhook URL for IRESS outage/recovery embeds. Unset = monitor runs
# but never posts. Must be set on Vercel + Railway for production alerts.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/…
# Heartbeat older than this → IRESS treated as offline (seconds, default 600).
IRESS_DOWN_AFTER_SEC=600
# Re-alert cadence while still offline (hours, default 24).
IRESS_REALERT_HOURS=24
# Staleness window for "who owns the price" (same knob the Yahoo cron uses;
# read-path fallback + this monitor both honour it).
IRESS_STALE_FALLBACK_HOURS=3

# ── App config ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Mint Wealth Navigator
NEXT_PUBLIC_APP_REGION=ZA
NEXT_PUBLIC_TICK_STREAM=/api/ticks
NEXT_PUBLIC_TICK_INTERVAL_MS=1100

# ── Ozone payment provider (Phase C6) ───────────────────────────────────
# Real Ozone API integration is blocked on Tsie confirming the vendor
# contract. Default mode is `mock`; the mock provider returns a fake
# redirect URL and fires a callback ~5 s later so the dev + verification
# flow can exercise every step end-to-end without leaving localhost.
#
# Set OZONE_MODE=live AND populate the URL + key to flip on real rails.
OZONE_MODE=mock
OZONE_API_URL=
OZONE_API_KEY=
OZONE_WEBHOOK_SECRET=
# Public base URL used by MockOzoneProvider to construct redirect URLs.
# Local dev: http://localhost:3000. Production: the live hostname.
OZONE_REDIRECT_BASE_URL=http://localhost:3000

# ── Broker feed worker (Phase C4) ───────────────────────────────────────
# Optional override that points /api/integration/health at the broker-ingest
# worker's public URL. Without this the broker health defaults to
# 'unconfigured'. Vercel URL convention: set BROKER_WORKER_URL to the
# Railway service's public domain.
BROKER_WORKER_URL=

# ── IRESS PROD worker (SENS) ─────────────────────────────────────────────
# Wired 2026-07-22 — separate Railway service that owns the IRESS
# PRODUCTION license seat (the UAT worker above holds the CT seat).
# See wealth-navigator/workers/iress-ingest/README.md "Prod worker".
#
# CRITICAL — prod worker must NEVER share creds with the UAT worker.
# `IRESS_MARKET_DATA_PROD=1` flips the prod market-data session onto
# `webservices.iress.co.za/v4`. The news loop's base URL is the same
# session, so no separate `IRESS_NEWS_BASE_URL` knob is needed.
IRESS_MARKET_DATA_PROD=0
IRESS_MARKETDATA_BASE_URL=https://webservices.iress.co.za/v4
# Per-loop pilot-write gate (worker-wide gates stay dry-run on this service).
IRESS_NEWS_INGEST=0
IRESS_NEWS_DRY_RUN=1
IRESS_NEWS_ALLOW_WRITES=0
IRESS_NEWS_VENDOR=SENS
IRESS_NEWS_MAX_ROWS=2000
IRESS_NEWS_INGEST_INTERVAL_SEC=21600
# Optional override: distinct sticky ApplicationID per replica (default
# `iress-ingest-prod-1`; only set when running multiple prod replicas for
# testing — single replica holds the prod seat per AGENTS.md).
# WORKER_ID=iress-ingest-prod-1
